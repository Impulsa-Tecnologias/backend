# =================================================================
# PLANTILLA DE CONFIGURACIÓN DEL BACKEND (Spring Boot)
# Copia este archivo como '.env' en este mismo directorio y configúralo
# =================================================================

# Conexión a la Base de Datos PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/nombre_de_tu_bd
DATABASE_USER=tu_usuario_postgres
DATABASE_PASSWORD=tu_contraseña_postgres

# Clave de Seguridad JWT (Debe ser de al menos 32 caracteres)
JWT_SECRET_KEY=clave_secreta_de_ejemplo_para_desarrollo_local_de_mas_de_32_caracteres

# API Key de OpenRouter (Opcional, valor por defecto: llave-no-proporcionada)
OPENROUTER_API_KEY=llave-no-proporcionada
